# Copy this file to .env and fill in your values:  cp .env.example .env

# ---------- Required ----------
# Gemini API key (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# ---------- Django ----------
DEBUG=True
# Comma-separated. Required when DEBUG=False, e.g. chat.example.com
ALLOWED_HOSTS=127.0.0.1,localhost
# Required for admin login over HTTPS, e.g. https://chat.example.com
CSRF_TRUSTED_ORIGINS=
# Only if a frontend on another domain calls the API, e.g. https://my-site.com
CORS_ALLOWED_ORIGINS=
CHATBOT_NAME=ChatBU
# Max questions per IP (DRF format: 20/min, 200/hour, 1000/day)
RATE_LIMIT=20/min
LOG_LEVEL=INFO

# ---------- Database ----------
# sqlite (default, nothing to install) | mysql | postgresql
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=

# ---------- Documents & index ----------
DOCUMENTS_PATH=data/documents
WEB_URLS_FILE=data/urls.txt
VECTOR_STORE_PATH=data/vector_store
# HuggingFace model name or a local folder. Rebuild the index if you change it.
EMBEDDING_MODEL=intfloat/e5-base-v2
# Set to 1 to never download models (they must already be cached)
HF_HUB_OFFLINE=0
CHUNK_SIZE=450
CHUNK_OVERLAP=75

# ---------- Retrieval & LLM ----------
TOP_K_DOCS=10
MIN_SIMILARITY_THRESHOLD=0.28
GENAI_MODEL_NAME=models/gemini-2.5-flash
GENAI_TEMPERATURE=0.3
GENAI_MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_LENGTH=100000
